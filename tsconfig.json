// Self-contained, so this folder also builds on its own (it is published as github.com/9in-io/sdk).
// Workspace packages export their TypeScript sources under the "@9in/source" condition.
{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": [
      "@9in/source"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": []
  },
  "include": [
    "src",
    "test"
  ]
}
